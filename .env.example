# Copy to .env and fill in. Every value is optional for local development:
# without Discord settings you get a "developer login" (pick any name).

# ---- Server -------------------------------------------------------------------
# Public address of the site, no trailing slash. Used for the Discord redirect URL.
# Local dev default: http://localhost:5173 (Vite). On Render this defaults to your onrender.com URL.
PUBLIC_URL=
PORT=3000
# Long random string that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_NAME=Reading Room

# ---- Discord login --------------------------------------------------------------
# Create an application at https://discord.com/developers/applications
# OAuth2 → Redirects → add  <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Only members of this Discord server can sign in (right-click the server → Copy Server ID).
DISCORD_GUILD_ID=
# Members with any of these role IDs are admins in every room (comma separated).
DISCORD_ADMIN_ROLE_IDS=
# Discord user IDs that are always admins (comma separated).
ADMIN_USER_IDS=
# Username-only login for testing. Never turn this on for a public site.
DEV_LOGIN=false

# ---- Storage --------------------------------------------------------------------
# Defaults to a SQLite file in DATA_DIR. For hosts without a persistent disk (Render free),
# use a free Turso database: DATABASE_URL=libsql://<db>-<org>.turso.io plus its token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DATA_DIR=./data
# auto | local | database. "auto" keeps books in the database when DATABASE_URL is remote.
STORAGE_DRIVER=auto
MAX_UPLOAD_MB=100
MAX_ROOMS_PER_USER=10
MAX_BOOKS_PER_ROOM=25

# ---- docker-compose + Caddy only ------------------------------------------------
# Domain Caddy should get an HTTPS certificate for, e.g. books.example.com or myclub.duckdns.org
DOMAIN=

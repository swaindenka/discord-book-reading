# Copy to .env and fill in. Every value is optional for local development:
# without Discord settings you get a "developer login" (pick any name).

# ---- Server -------------------------------------------------------------------
# Public address of the site, no trailing slash. Used for the Discord redirect URL.
# Local dev default: http://localhost:5173 (Vite). On Render this defaults to your onrender.com URL.
PUBLIC_URL=
PORT=3000
# Long random string that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_NAME=Reading Room

# ---- Discord login --------------------------------------------------------------
# Create an application at https://discord.com/developers/applications
# OAuth2 → Redirects → add  <PUBLIC_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: only members of these Discord servers can sign in (comma separated server IDs).
# Leave empty to let anyone with a Discord account in.
DISCORD_GUILD_IDS=
# Optional, needs DISCORD_GUILD_IDS: members with one of these role IDs are admins in every room.
DISCORD_ADMIN_ROLE_IDS=
# Discord user IDs of the site's root admins (comma separated). They have owner rights in every
# room and can add or remove more admins from the site (account menu → Site admins).
# Find an ID: Discord → Settings → Advanced → Developer Mode, then right-click a person → Copy User ID.
ADMIN_USER_IDS=
# Username-only login for testing. Never turn this on for a public site.
DEV_LOGIN=false

# ---- Storage --------------------------------------------------------------------
# Defaults to a SQLite file in DATA_DIR. For hosts without a persistent disk (Render free),
# use a free Turso database: DATABASE_URL=libsql://<db>-<org>.turso.io plus its token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DATA_DIR=./data
# auto | local | database. "auto" keeps books in the database when DATABASE_URL is remote.
STORAGE_DRIVER=auto
MAX_UPLOAD_MB=100
MAX_ROOMS_PER_USER=10
MAX_BOOKS_PER_ROOM=25

# ---- Dictionary (select a word in a book to see its meaning) ---------------------
# auto: Oxford Dictionaries when the keys below are set, otherwise the free Wiktionary-based
# dictionary (dictionaryapi.dev). free | oxford | off are also accepted.
DICTIONARY_PROVIDER=auto
# Oxford Dictionaries API keys (https://developer.oxforddictionaries.com). The pop-over always
# links to the free Oxford Learner's Dictionary website as well.
OXFORD_APP_ID=
OXFORD_APP_KEY=
OXFORD_LANGUAGE=en-gb

# ---- docker-compose + Caddy only ------------------------------------------------
# Domain Caddy should get an HTTPS certificate for, e.g. books.example.com or myclub.duckdns.org
DOMAIN=

{
  "//": "Editor-only config. Builds use tsconfig.server.json and tsconfig.client.json.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["client/src", "server", "shared", "tests", "vite.config.ts", "vitest.config.ts"]
}
